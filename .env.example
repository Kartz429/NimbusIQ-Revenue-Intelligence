# Copy to .env and fill in. .env is git-ignored - never commit real values.

# --- Snowflake (dbt, dev target: password auth) ---------------------------
SNOWFLAKE_ACCOUNT=xy12345.eu-west-1     # account identifier, not the full URL
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER_ROLE
SNOWFLAKE_WAREHOUSE=NIMBUSIQ_WH
SNOWFLAKE_DATABASE=NIMBUSIQ

# --- dbt -------------------------------------------------------------------
DBT_TARGET=dev
DBT_SCHEMA=DBT_YOURNAME                 # personal schema prefix for dev runs
DBT_PROFILES_DIR=profiles               # relative to nimbusiq/

# --- ci / prod targets (key-pair auth; set these as GitHub secrets) -------
# SNOWFLAKE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
